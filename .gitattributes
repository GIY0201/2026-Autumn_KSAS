# Keep repository text consistent across Windows and other platforms.
* text=auto eol=lf
# Preserve Markdown hard line breaks and existing document-ending blank lines.
*.md whitespace=-blank-at-eol,-blank-at-eof
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
# Source evidence is checksum-pinned and must survive clone byte-for-byte.
data_sources/** binary
