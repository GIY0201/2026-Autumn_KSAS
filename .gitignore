# Local environments, caches, tooling state, and logs.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
.codeboarding/
.codex/
.agents/
.idea/
.vscode/
*.log
.DS_Store
Thumbs.db

# Credentials must stay outside the public repository.
.env
.env.*
!.env.example
!.env.*.example
.netrc
_netrc
.pypirc
.npmrc
credentials*.json
client_secret*.json
*.pem
*.key
*.p12
*.pfx

# Original archives and binary datasets/checkpoints are stored locally.
*.zip
*.7z
*.tar
*.gz
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.onnx

# Keep reproducibility sources in Git so a clean clone can run every preset.
# The user-provided archive remains local; generated datasets stay excluded below.
!/data_sources/**/*.npy

# Keep directory guidance, but not generated datasets, exports, or scratch files.
/outputs/*
!/outputs/AGENTS.md
!/outputs/README.md
/temp/*
!/temp/AGENTS.md
!/temp/README.md
